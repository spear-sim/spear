SPEAR:
  LAUNCH_MODE: "none"

  INSTANCE:
    CLIENT_INTERNAL_TIMEOUT_SECONDS: 30.0 # set this to longer than usual because it takes a few seconds to spawn the robot character for the first time

SP_SERVICES:
  INITIALIZE_ENGINE_SERVICE:
    OVERRIDE_BENCHMARKING: True
    BENCHMARKING: True

    OVERRIDE_FIXED_DELTA_TIME: True
    FIXED_DELTA_TIME: 0.016667 # 1.0/60.0

  WORLD_REGISTRY_SERVICE:
    OVERRIDE_GAME_PAUSED: True
    GAME_PAUSED: False
